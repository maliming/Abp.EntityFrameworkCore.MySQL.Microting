<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Abp.EntityFrameworkCore.MySQL.Microting</AssemblyName>
    <PackageId>Abp.EntityFrameworkCore.MySQL.Microting</PackageId>
    <RootNamespace />
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Description>ABP EF Core MySQL provider package backed by the Microting fork of Pomelo.EntityFrameworkCore.MySql.</Description>
    <Authors>Ma Liming</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/maliming/Abp.EntityFrameworkCore.MySQL.Microting</RepositoryUrl>
    <PackageProjectUrl>https://github.com/maliming/Abp.EntityFrameworkCore.MySQL.Microting</PackageProjectUrl>
    <PackageTags>abp;entity-framework-core;mysql;microting;pomelo</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.EntityFrameworkCore" Version="$(AbpVersion)" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="$(MicrotingMySqlVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
  </ItemGroup>

</Project>
